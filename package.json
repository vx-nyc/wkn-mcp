{
  "name": "@vx-nyc/vx-mcp",
  "version": "1.0.8",
  "private": false,
  "description": "Installer for the hosted VX memory MCP server. Wires up Claude Code, Cursor, Codex, OpenClaw, and Hermes to https://api.onememory.co/mcp over HTTP with OAuth.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vx-mcp": "./dist/index.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "bash scripts/check-no-secrets.sh",
    "check:all": "npm run build && npm test && npm run check:secrets"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "ai-memory",
    "memory",
    "persistent-memory",
    "context",
    "claude",
    "claude-code",
    "cursor",
    "codex",
    "openclaw",
    "hermes",
    "oauth",
    "llm",
    "knowledge-base",
    "long-term-memory",
    "vx"
  ],
  "author": {
    "name": "One Memory Inc"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vx-nyc/vx-mcp.git"
  },
  "homepage": "https://github.com/vx-nyc/vx-mcp",
  "bugs": {
    "url": "https://github.com/vx-nyc/vx-mcp/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/vx-nyc"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "skills",
    ".claude-plugin",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "openclaw.plugin.json"
  ]
}
